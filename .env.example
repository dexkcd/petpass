# --- Database ---
DATABASE_URL=postgresql://petpass:petpass@localhost:5432/petpass

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app. Production: https://<your-app>.up.railway.app
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Google Maps ---
# Browser key (HTTP-referrer restricted). Enable: Maps JavaScript API, Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key (IP restricted or unrestricted). Enable: Geocoding API.
GOOGLE_MAPS_SERVER_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where uploaded pet documents are written. Production: a Railway volume, e.g. /data/uploads
UPLOADS_DIR=./uploads
# Set to "true" to seed demo accounts/clinics (never enable on a real production DB)
SEED_DEMO=true
# Set to "true" to wipe every table before seeding (demo databases only!)
SEED_RESET=false
